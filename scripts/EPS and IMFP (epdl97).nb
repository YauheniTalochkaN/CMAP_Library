                RowBox[{"\[Sqrt]", "en"}], 
                RowBox[{"\[Sqrt]", 
                 RowBox[{"(", 
                  RowBox[{"en", "+", 
                   RowBox[{"2", " ", "mc2"}]}], ")"}]}]}], "+", 
               RowBox[{
                RowBox[{"\[Sqrt]", 
