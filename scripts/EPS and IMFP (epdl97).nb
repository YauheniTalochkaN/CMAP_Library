  RowBox[{"mec2", "=", "510998.95"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalF]q", "[", 
    RowBox[{"en_", ",", "\[Omega]_", ",", "iminveps_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"en", ">", "\[Omega]"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"x", "+", "mec2"}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "+", 
            SuperscriptBox["10", 
             RowBox[{"-", "15"}]]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"2", " ", "mec2"}]}], ")"}]}]], 
        RowBox[{"iminveps", "[", 
         RowBox[{"\[Omega]", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"x", ">=", 
