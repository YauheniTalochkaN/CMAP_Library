Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"G", "[", 
    RowBox[{"k_", ",", "s_", ",", "\[CapitalOmega]_", ",", "temper_"}], "]"}],
    ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        FractionBox["1", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           FractionBox[
            RowBox[{"23200", " ", "\[CapitalOmega]"}], 
            RowBox[{"2", "temper"}]]]}]]}], ",", 
       RowBox[{"b", "=", 
        FractionBox[
         SuperscriptBox["\[ExponentialE]", 
          FractionBox[
           RowBox[{"23200", " ", "\[CapitalOmega]"}], 
           RowBox[{"2", "temper"}]]], 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[ExponentialE]", 
           FractionBox[
            RowBox[{"23200", " ", "\[CapitalOmega]"}], 
            RowBox[{"2", "temper"}]]]}]]}]}], "}"}], ",", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "s"}], 
         RowBox[{"(", 
          RowBox[{"a", "+", "b"}], ")"}]}]], "\[CapitalOmega]"], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox["a", "b"], ")"}], 
       FractionBox["k", "2"]], "*", 
      RowBox[{"BesselI", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "k", "]"}], ",", 
        RowBox[{"2", " ", 
         SqrtBox["a"], " ", 
         SqrtBox["b"], " ", "s"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9053232681674967`*^9, 3.9053232782627296`*^9}, {
