Cell[BoxData[{
 RowBox[{
  RowBox[{"iminvepsextlist", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"list\[Omega]", "[", 
          RowBox[{"[", "kk", "]"}], "]"}], ",", 
         RowBox[{"list\[CapitalEpsilon]q", "[", 
          RowBox[{"[", "jj", "]"}], "]"}], ",", 
         RowBox[{"Im", "[", 
          RowBox[{"-", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"reeps", "[", 
               RowBox[{"list\[Omega]", "[", 
                RowBox[{"[", "kk", "]"}], "]"}], "]"}], "+", 
              RowBox[{"I", " ", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"partEps2extfunc", "[", 
                   RowBox[{"[", "ii", "]"}], "]"}], "[", 
                  RowBox[{
                   RowBox[{"list\[Omega]", "[", 
                    RowBox[{"[", "kk", "]"}], "]"}], ",", 
                   RowBox[{"list\[CapitalEpsilon]q", "[", 
                    RowBox[{"[", "jj", "]"}], "]"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"ii", ",", 
                   RowBox[{"Length", "[", "SubShells", "]"}]}], "}"}]}], 
                "]"}]}]}], ")"}], 
            RowBox[{"-", "1"}]]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"kk", ",", 
         RowBox[{"Length", "[", "list\[Omega]", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", 
         RowBox[{"Length", "[", "list\[CapitalEpsilon]q", "]"}]}], "}"}]}], 
      "]"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iminvepsext", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"iminvepsextlist", ",", 
     RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.865946180032837*^9, 3.8659462194238067`*^9}, {
  3.865947679264256*^9, 3.865947679871213*^9}, {3.866020323929429*^9, 
  3.8660204135529904`*^9}, {3.866020445897731*^9, 3.8660204856252337`*^9}, {
