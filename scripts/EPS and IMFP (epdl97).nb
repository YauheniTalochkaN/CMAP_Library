            SuperscriptBox[
             RowBox[{"(", "mec2", ")"}], "2"]}]], "-", "mec2"}]}], "}"}], ",", 
       RowBox[{"Method", "\[Rule]", "\"\<LocalAdaptive\>\""}]}], "]"}], ",", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dedx", "[", 
    RowBox[{"en_", ",", "\[ScriptCapitalF]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["\[CapitalZeta]", "2"], 
     RowBox[{"\[Pi]", " ", "aB"}]], " ", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{
       FractionBox["\[Omega]", "en"], " ", 
