            SuperscriptBox["10", "5"], ",", "x"}], "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"\[Sqrt]", "en"}], 
                RowBox[{"\[Sqrt]", 
                 RowBox[{"(", 
                  RowBox[{"en", "+", 
                   RowBox[{"2", " ", "mc2"}]}], ")"}]}]}], "-", 
               RowBox[{
                RowBox[{"\[Sqrt]", 
                 RowBox[{"(", 
                  RowBox[{"en", "-", "\[Omega]"}], ")"}]}], 
                RowBox[{"\[Sqrt]", 
                 RowBox[{"(", 
                  RowBox[{"en", "-", "\[Omega]", "+", 
                   RowBox[{"2", " ", "mc2"}]}], ")"}]}]}]}], ")"}], "2"], "+", 
