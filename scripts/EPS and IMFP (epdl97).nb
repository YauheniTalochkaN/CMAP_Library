Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"partEps2ext", "[", 
    RowBox[{"\[Omega]_", ",", "\[CapitalEpsilon]q_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"\[CapitalEpsilon]q", ">", "0"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[CapitalEpsilon]i", "=", 
         RowBox[{
          SuperscriptBox["10", "6"], 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
             "SubShells", "\[LeftDoubleBracket]", "ii", 
              "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "7", 
             "\[RightDoubleBracket]"}], "-", 
            RowBox[{"EnergyCorrections", "\[LeftDoubleBracket]", 
             RowBox[{
              RowBox[{
              "SubShells", "\[LeftDoubleBracket]", "ii", 
               "\[RightDoubleBracket]"}], "\[LeftDoubleBracket]", "6", 
              "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}]}], 
           ")"}]}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"\[Omega]", ">", "\[CapitalEpsilon]i"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           FractionBox["1", 
            RowBox[{"4", 
             SqrtBox[
              RowBox[{"\[CapitalEpsilon]q", "+", 
               SuperscriptBox["10", 
                RowBox[{"-", "15"}]]}]], " ", 
             RowBox[{"(", 
              RowBox[{"\[Omega]", "+", 
               SuperscriptBox["10", 
                RowBox[{"-", "15"}]]}], ")"}]}]], "*", 
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              FractionBox["x", 
               SqrtBox[
                RowBox[{"x", "-", "\[CapitalEpsilon]i"}]]], " ", 
              RowBox[{
               RowBox[{"partialEps2listfunc", "[", 
                RowBox[{"[", "ii", "]"}], "]"}], "[", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"x", ">=", 
                  SuperscriptBox["10", "6"]}], ",", 
                 SuperscriptBox["10", "6"], ",", "x"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"\[CapitalEpsilon]i", "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SqrtBox[
                    RowBox[{"\[Omega]", "-", "\[CapitalEpsilon]i"}]], "-", 
                   SqrtBox["\[CapitalEpsilon]q"]}], ")"}], "2"]}], ",", 
               RowBox[{"\[CapitalEpsilon]i", "+", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   SqrtBox[
                    RowBox[{"\[Omega]", "-", "\[CapitalEpsilon]i"}]], "+", 
                   SqrtBox["\[CapitalEpsilon]q"]}], ")"}], "2"]}]}], "}"}], 
             ",", 
             RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}]}], "]"}]}], 
          ",", "0"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", 
         RowBox[{"Length", "[", "SubShells", "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"partialEps2listfunc", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "[", "\[Omega]", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", 
         RowBox[{"Length", "[", "SubShells", "]"}]}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}]], "Input",
