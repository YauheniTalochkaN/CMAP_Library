Cell[BoxData[{
 RowBox[{
  RowBox[{"imepsinvlist", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{
            FractionBox[
             RowBox[{"i", "-", "1"}], "nn"], "eKraKroMax"}], "]"}], 
          SuperscriptBox["10", "6"]}], ",", 
         RowBox[{"Im", "[", 
          RowBox[{"-", 
           FractionBox["1", 
            RowBox[{
             RowBox[{
             "a", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "+",
              "1", " ", "+", " ", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"TotalEps2", "[", 
               RowBox[{
                FractionBox[
                 RowBox[{"i", "-", "1"}], "nn"], "eKraKroMax"}], "]"}]}]}]]}],
           "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nn"}], "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"TotalEps2", "[", 
          RowBox[{"x", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"eKraKroMax", " ", 
           SuperscriptBox["10", "6"]}], "+", "1"}], ",", "10000", ",", "1"}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"TotalEps2", "[", 
          RowBox[{"x", " ", 
           SuperscriptBox["10", 
            RowBox[{"-", "6"}]]}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "10010", ",", "100000", ",", "10"}], "}"}]}], "]"}],
      ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", 
